{
  "name": "inline-image-preview",
  "displayName": "Inline Image Preview — Base64, Data URI & URL",
  "description": "Hover a base64 string, data: URI, or image URL in any file to see the picture inline. Works in JSON, API responses, logs, fixtures, and code.",
  "version": "0.2.0",
  "publisher": "aniusch",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "base64",
    "base64 image",
    "data uri",
    "data url",
    "image",
    "image preview",
    "hover",
    "thumbnail",
    "json",
    "api",
    "png",
    "jpeg",
    "svg",
    "webp"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#141b2d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aniusch/image-preview-ext.git"
  },
  "bugs": {
    "url": "https://github.com/aniusch/image-preview-ext/issues"
  },
  "homepage": "https://github.com/aniusch/image-preview-ext#readme",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "imagePreview.showSelection",
        "title": "Image Preview: Preview Selection / String"
      }
    ],
    "configuration": {
      "title": "Inline Image Preview",
      "properties": {
        "imagePreview.previewUrls": {
          "type": "boolean",
          "default": true,
          "description": "Preview http(s) image URLs on hover. This fetches the URL to check whether it is an image; disable to prevent any network requests from hovering."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/detect.test.js",
    "test:integration": "node test/integration/run.js",
    "package": "npx --yes @vscode/vsce@latest package",
    "publish:vsce": "npx --yes @vscode/vsce@latest publish",
    "publish:ovsx": "npx --yes ovsx@latest publish"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2"
  }
}
